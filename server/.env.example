# Port for Express server
PORT=3001

# Allowed origin for CORS (Vercel frontend or local Vite dev)
FRONTEND_ORIGIN=http://localhost:8080

# Google Gemini API configuration
# Acquire your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# n8n Webhook configuration for Save to Notion
N8N_NOTION_WEBHOOK_URL=

# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Authorized JavaScript Origins: http://localhost:8080
GOOGLE_CLIENT_ID=your_google_client_id

# JWT Session Secret (generate a strong 64-character random string, e.g. via `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_secret

# MySQL Database configuration (local or hosted provider like Aiven, TiDB, AWS RDS, Railway)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=brandvoice_db
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
# Enable SSL/TLS for hosted MySQL cloud databases (set to 'true' in production)
MYSQL_SSL=false
# Cloud CA certificate PEM text (required for Aiven MySQL strict TLS verification)
# MYSQL_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Skip 'CREATE DATABASE IF NOT EXISTS' query for managed MySQL accounts with restricted permissions
MYSQL_SKIP_CREATE_DB=false
# Alternative: full MySQL connection string
# DATABASE_URL=mysql://user:password@host:port/database?ssl-mode=REQUIRED

# Notion Public OAuth 2.0 Integration (for per-user workspace authorization)
# Create a public integration at: https://www.notion.so/my-integrations
# Under Distribution, set integration to 'Public' and configure Redirect URI below.
NOTION_OAUTH_CLIENT_ID=your_notion_client_id
NOTION_OAUTH_CLIENT_SECRET=your_notion_client_secret
NOTION_OAUTH_REDIRECT_URI=http://localhost:3001/api/notion/oauth/callback

# Notion Token Encryption Key (dedicated 64-character hex key for AES-256-GCM token encryption at rest)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTION_TOKEN_ENCRYPTION_KEY=replace_with_a_64_character_hex_encryption_key
