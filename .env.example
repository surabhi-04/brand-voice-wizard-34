# API Base URL:
# For local development with separate Express port: http://localhost:3001
# For unified production deployment on Vercel: leave empty (uses same-origin relative /api/*)
# For split production deployment with separate API host: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:3001

# Google OAuth 2.0 Client ID for frontend GIS initialization (matches backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id